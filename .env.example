# ================================================================
# Studio OS — .env.example
# Kopyala: cp .env.example apps/api/.env
# UYARI: Gerçek sırları asla bu dosyaya yazma! Bu dosya repodadır.
# ================================================================

# ─────────────────────────────────────────────────────────────────
# Veritabanı
# Yerel Docker: postgresql://studio_os:studio_os_secret@localhost:5432/studio_os_dev
# Bulut (Neon, Supabase vb.): bağlantı string'ini buraya yapıştır
# ─────────────────────────────────────────────────────────────────
POSTGRES_USER=studio_os
POSTGRES_PASSWORD=studio_os_secret
POSTGRES_DB=studio_os_dev
POSTGRES_PORT=5432

DATABASE_URL="postgresql://studio_os:studio_os_secret@localhost:5432/studio_os_dev?sslmode=require"

# ─────────────────────────────────────────────────────────────────
# API Sunucusu
# ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────
# JWT (Üretimde yüksek-entropi rastgele string kullan)
# Üretim örneği: openssl rand -base64 64
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-prod
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Upstash (prod/staging; yerel ortamda boş bırak)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────────────────────────
# E-posta (Mailpit — geliştirme SMTP yakalayıcısı)
# Mailpit UI: http://localhost:8025
# ─────────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@studio-os.local"

# ─────────────────────────────────────────────────────────────────
# Nesne Depolama — Cloudflare R2 / AWS S3 uyumlu
# Yerel geliştirme için MinIO kullanılabilir (make dev --profile storage)
# ─────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="studio-os-dev"
R2_PUBLIC_DOMAIN=""

# ─────────────────────────────────────────────────────────────────
# Gözlemlenebilirlik (prod/staging; yerel ortamda boş bırak)
# ─────────────────────────────────────────────────────────────────
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ─────────────────────────────────────────────────────────────────
# Inngest (iş kuyruğu / event bus)
# ─────────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─────────────────────────────────────────────────────────────────
# iyzico (ödeme) — MVP kapsamında
# Sandbox: https://sandbox-api.iyzipay.com
# ─────────────────────────────────────────────────────────────────
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# ─────────────────────────────────────────────────────────────────
# Rate Limit
# ─────────────────────────────────────────────────────────────────
RATE_LIMIT_REGISTER_WINDOW_MS=60000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_WINDOW_MS=900000
RATE_LIMIT_FORGOT_MAX=3
