{
  "name": "studio-os-monorepo",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "turbo": "latest",
    "dependency-cruiser": "latest"
  }
}
