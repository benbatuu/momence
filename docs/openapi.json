{"openapi":"3.1.0","info":{"title":"Studio OS API","version":"1.0.0","description":"Butik fitness ve wellness stüdyoları için modüler monolit yönetim API dokümantasyonu.","contact":{"name":"Studio OS Mühendislik Ekibi"}},"servers":[{"url":"http://localhost:3000","description":"Yerel Geliştirme Sunucusu"}],"security":[{"BearerAuth":[]}],"components":{"schemas":{},"parameters":{}},"paths":{"/health":{"get":{"tags":["Sistem ve Sağlık"],"summary":"Canlılık Kontrolü (Liveness Probe)","description":"API sunucusunun çalıştığını doğrular. Altyapı ve orkestrasyon tarafından kullanılır.","responses":{"200":{"description":"Sunucu canlı ve istek kabul ediyor","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","example":"ok"},"timestamp":{"type":"string","example":"2026-10-04T00:00:00.000Z"}},"required":["status","timestamp"]}}}}}}},"/ready":{"get":{"tags":["Sistem ve Sağlık"],"summary":"Hazır Olma Kontrolü (Readiness Probe)","description":"Veritabanı (PostgreSQL) ve Redis bağlantılarını test ederek servisin trafik almaya hazır olduğunu doğrular.","responses":{"200":{"description":"Tüm bağımlılıklar sağlıklı","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","example":"ready"},"checks":{"type":"object","properties":{"database":{"type":"string","enum":["up","down"],"example":"up"},"redis":{"type":"string","enum":["up","down"],"example":"up"}},"required":["database","redis"]},"timestamp":{"type":"string","example":"2026-10-04T00:00:00.000Z"}},"required":["status","checks","timestamp"]}}}},"503":{"description":"Bir veya daha fazla bağımlılık erişilemez durumda","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","example":"ready"},"checks":{"type":"object","properties":{"database":{"type":"string","enum":["up","down"],"example":"up"},"redis":{"type":"string","enum":["up","down"],"example":"up"}},"required":["database","redis"]},"timestamp":{"type":"string","example":"2026-10-04T00:00:00.000Z"}},"required":["status","checks","timestamp"]}}}}}}},"/status":{"get":{"tags":["Sistem ve Sağlık"],"summary":"Sistem Durumu ve Metrikler","description":"Uptime, bellek tüketimi ve sürüm bilgilerini döner.","responses":{"200":{"description":"Sistem durumu","content":{"application/json":{"schema":{"type":"object","properties":{"service":{"type":"string","example":"studio-os-api"},"version":{"type":"string","example":"1.0.0"},"environment":{"type":"string","example":"development"},"uptimeSeconds":{"type":"number","example":42.5},"memory":{"type":"object","properties":{"rssMb":{"type":"number","example":45.2},"heapUsedMb":{"type":"number","example":28.1}},"required":["rssMb","heapUsedMb"]},"timestamp":{"type":"string","example":"2026-10-04T00:00:00.000Z"}},"required":["service","version","environment","uptimeSeconds","memory","timestamp"]}}}}}}},"/v1/admin/dashboard":{"get":{"tags":["Admin Paneli"],"summary":"Yönetici Paneli Genel Özeti","description":"Aktif stüdyo için özet metrikleri döner.","responses":{"200":{"description":"Başarılı özet verisi","content":{"application/json":{"schema":{"type":"object","properties":{"activeMembers":{"type":"number","example":120},"todayBookings":{"type":"number","example":45},"monthlyRevenueKurus":{"type":"number","example":12500000}},"required":["activeMembers","todayBookings","monthlyRevenueKurus"]}}}}}}},"/v1/me/profile":{"get":{"tags":["Müşteri (Me)"],"summary":"Giriş Yapan Müşteri Profili","description":"Müşterinin profil, üyelik ve rezervasyon durumunu döner.","responses":{"200":{"description":"Müşteri profili","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid","example":"018f2f45-6789-7000-8000-000000000001"},"name":{"type":"string","example":"Ayşe Yılmaz"},"email":{"type":"string","format":"email","example":"ayse@example.com"}},"required":["id","name","email"]}}}},"401":{"description":"Yetkisiz erişim"}}}},"/v1/public/{slu